# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git. Never commit real keys.

# --- Browser (safe to expose: protected by database access rules) ---
# Supabase dashboard > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Scripts run on your own machine only (seed, accuracy test) ---
# Bypasses access rules. Never prefix with VITE_, never put in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Edge Function secrets: NOT set in this file ---
# Set them with `npx supabase secrets set NAME=value` once a model is chosen.
#   MODEL_PROVIDER   which provider judges; "mock" when unset
#   MODEL_API_KEY    the model key; it must never appear in the repository

# --- Demo account created by `npm run db:seed` ---
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
